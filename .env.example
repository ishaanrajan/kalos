# Copy to .env and fill in from your Supabase project settings (API section).
# The anon key is safe to ship in a client app — row-level security is what
# actually protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Used by scripts/seed.ts. NEVER prefix this with EXPO_PUBLIC_
# and never commit the real value — it bypasses row-level security entirely.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
