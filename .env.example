# Copy to .env and fill in from your Supabase project settings (API section).
# The anon key is safe to ship in a client app — row-level security is what
# actually protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Used by scripts/seed.ts. NEVER prefix this with EXPO_PUBLIC_
# and never commit the real value — it bypasses row-level security entirely.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GIF comments (lib/giphy.ts). Free key from developers.giphy.com.
EXPO_PUBLIC_GIPHY_API_KEY=your-giphy-api-key

# Music on posts (lib/music.ts). A signed JWT, not an API key — mint it with
# `npx tsx scripts/mint-apple-music-token.ts` (needs a MusicKit private key
# in secrets/, see that script's header comment and supabase/README.md).
# Valid up to 6 months; re-mint and redeploy before it expires.
EXPO_PUBLIC_APPLE_MUSIC_DEVELOPER_TOKEN=your-apple-music-developer-token
